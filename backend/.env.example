# Keep this variable name. Use your OpenAI API key.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-nano
# Firebase service account JSON file path (relative to backend locally).
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-key.json
STORAGE_BACKEND=sqlite
SQLITE_DATABASE_PATH=local.sqlite3

# Comma-separated frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ai-assistant-eight-plum.vercel.app
HOST=127.0.0.1
PORT=8000
